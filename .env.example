# LifeMap Environment Variables
# Copy this file to .env.local and fill in your actual Supabase credentials.
# NEVER commit .env or .env.local containing real keys.
# NEVER use your Supabase service_role key in frontend applications.

# 1. Supabase Project URL (found in Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (found in Project Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key
