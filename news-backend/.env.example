# Life OS News Backend Environment Configuration
# Copy this file to .env:  cp .env.example .env

# Optional Extra APIs (All completely optional; if omitted, the app runs on 100% free direct RSS feeds)
# 1. The Guardian Open Platform (Free 500 req/day): https://open-platform.theguardian.com/access/
GUARDIAN_KEY=

# 2. Currents API (Free 250 req/day): https://currentsapi.services/en/pricing
CURRENTS_KEY=

# 3. NewsData.io (Free 200 credits/day, supports ta & en): https://newsdata.io/pricing
NEWSDATA_KEY=

# 4. Anthropic Claude API (For Jarvis 5-bullet daily AI briefing): https://console.anthropic.com/
ANTHROPIC_KEY=
CLAUDE_MODEL=claude-3-haiku-20240307

# Server Configuration
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

